<Window x:Class="KidClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:KidClock.ViewModels"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" Background="#E6F7FF">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavButtonStyle">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#87CEFA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00BFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E90FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧边导航栏 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,20">
                <TextBlock Text="KidClock" FontSize="32" FontWeight="Bold" Foreground="#FF69B4" 
                           HorizontalAlignment="Center" Margin="0,0,0,30" FontFamily="Comic Sans MS"/>

                <Button Content="时钟认知" Command="{Binding NavigateCommand}" CommandParameter="ClockFaceView" Style="{StaticResource NavButtonStyle}" Background="#FF69B4"/>
                <Button Content="时间魔法" Command="{Binding NavigateCommand}" CommandParameter="TimeRelationView" Style="{StaticResource NavButtonStyle}" Background="#FFA500"/>
                <Button Content="时间侦探" Command="{Binding NavigateCommand}" CommandParameter="TimeDetectiveView" Style="{StaticResource NavButtonStyle}" Background="#32CD32"/>
                <Button Content="拼图挑战" Command="{Binding NavigateCommand}" CommandParameter="PuzzleView" Style="{StaticResource NavButtonStyle}" Background="#9370DB"/>
                <Button Content="时间认知" Command="{Binding NavigateCommand}" CommandParameter="TimeCognitionView" Style="{StaticResource NavButtonStyle}" Background="#FFD700"/>
                <Button Content="拼音配对" Command="{Binding NavigateCommand}" CommandParameter="PinyinPairingView" Style="{StaticResource NavButtonStyle}" Background="#FF6B6B"/>
                
            </StackPanel>
        </Border>

        <!-- 内容区域 -->
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainRegion" Margin="10"/>
    </Grid>
</Window>